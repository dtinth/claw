{
  "name": "@dtinth/claw",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    "start": "deno run src/main.ts",
    "test": "deno test",
    "check": "deno check src/",
    "ci": "deno fmt --check && deno lint && deno check src/ && deno test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["README.md"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [".git"]
}
