{
  "name": "@dtinth/claw",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env src/main.ts",
    "start": "deno run --allow-net --allow-env src/main.ts",
    "test": "deno test --allow-net --allow-env",
    "check": "deno check src/",
    "ci": "deno fmt --check && deno lint && deno check src/ && deno task test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "hono": "jsr:@hono/hono@^4.12.31",
    "hono/cookie": "jsr:@hono/hono@^4.12.31/cookie",
    "jose": "npm:jose@^6.2.3"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["README.md"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [".git", "agent"]
}
